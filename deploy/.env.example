# Token do GitHub (só leitura de repositórios públicos basta). Não versione o .env.
GITHUB_TOKEN=

# Domínio público da VM, sem https:// (ex.: poc-msr.brazilsouth.cloudapp.azure.com).
# Com um domínio, o Caddy emite o certificado HTTPS automaticamente.
SITE_ADDRESS=

# Limites da análise.
MAX_REPO_SIZE_MB=500
GIT_TIMEOUT_SECONDS=600
